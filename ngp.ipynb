# Installera paket om de saknas (kör denna rad en gång):
# !pip install geopandas shapely matplotlib requests

import base64
import json
import requests
import geopandas as gpd
import matplotlib.pyplot as plt
from shapely.geometry import shape


# ============================================================
# *** FYLL I DINA NYCKLAR HÄR ***
# ============================================================
import os
CONSUMER_KEY = os.environ.get("CONSUMER_KEY")
CONSUMER_SECRET = os.environ.get("CONSUMER_SECRET")

# ============================================================


# --- Hämta OAuth-token automatiskt ---
TOKEN_URL = "https://apimanager.lantmateriet.se/oauth2/token"

def hamta_token(key: str, secret: str) -> str:
    creds = base64.b64encode(f"{key}:{secret}".encode()).decode()
    resp  = requests.post(
        TOKEN_URL,
        data={"grant_type": "client_credentials"},
        headers={
            "Authorization": f"Basic {creds}",
            "Content-Type":  "application/x-www-form-urlencoded",
        },
    )
    if resp.status_code == 401:
        print("❌ 401 – Consumer Key eller Secret är fel. Kontrollera att du kopierade rätt.")
        resp.raise_for_status()
    if not resp.ok:
        print(f"❌ Token-fel {resp.status_code}: {resp.text}")
        resp.raise_for_status()

    token = resp.json()["access_token"]
    print(f"✅ Token hämtad!")

    # Kontrollera scope – avslöjar om prenumeration saknas
    parts = token.split(".")
    if len(parts) >= 2:
        try:
            pad     = parts[1] + "=" * (-len(parts[1]) % 4)
            payload = json.loads(base64.urlsafe_b64decode(pad))
            scope   = payload.get("scope", "")
            print(f"   Scope i token: '{scope}'")
            if not scope or scope in ("default", "am_application_scope default"):
                print()
                print("⚠️  Scopet är tomt – API-prenumerationen saknas troligen!")
                print("   Gå till apimanager.lantmateriet.se → din app")
                print("   → Subscriptions → prenumerera på Geodatakatalog-Sokning")
                print("   Generera sedan nya nycklar och kör om.")
        except Exception:
            pass  # opaque token, hoppa över scope-kontroll

    return token



# ============================================================
# *** KLISTRA IN DITT MANUELLA TOKEN HÄR (från API-portalen) ***
# Gå till: Applications → din app → Application Keys
# → Generate Access Token → kopiera det långa tokenet
# ============================================================
MANUELLT_TOKEN = "klistra_in_ditt_token_här"

# Kommentera bort raden nedan om du vill använda manuellt token:
token = hamta_token(CONSUMER_KEY, CONSUMER_SECRET)

# Avkommentera raden nedan för att använda manuellt token:
# token = MANUELLT_TOKEN

HEADERS = {
    "Accept":        "application/json",
    "Authorization": f"Bearer {token}",
}


# ============================================================
# API-URL (produktion)
# ============================================================

BASE = "https://api.lantmateriet.se/distribution/geodatakatalog/sokning/v1/detaljplan/v2"


# ============================================================
# Hjälpfunktion för GET-anrop
# ============================================================

def api_get(url: str, params: dict = None) -> dict:
    resp = requests.get(url, params=params, headers=HEADERS)
    if not resp.ok:
        print(f"❌ HTTP {resp.status_code} – svar från servern:")
        print(f"   Body  : {resp.text[:500]}")
        print(f"   Headers: {dict(resp.headers)}")
    resp.raise_for_status()
    return resp.json()


# ============================================================
# Steg 1 – Utforska landing page och collections
# ============================================================

print("=== Landing page ===")
lp = api_get(BASE)
print(json.dumps(lp, indent=2, ensure_ascii=False)[:600])

print("\n=== Tillgängliga collections ===")
data        = api_get(f"{BASE}/collections")
collections = data.get("collections", [])

for c in collections:
    print(f"  id    : {c.get('id')}")
    print(f"  title : {c.get('title')}")
    print()


# ============================================================
# Steg 2 – Välj collection och sök detaljplaner
# ============================================================

COLLECTION_ID = collections[0]["id"] if collections else "detaljplan"
ITEMS_URL     = f"{BASE}/collections/{COLLECTION_ID}/items"
print(f"Använder collection : {COLLECTION_ID}")
print(f"Items-URL           : {ITEMS_URL}\n")


def sok_detaljplaner(
    bbox: tuple = None,   # (min_lon, min_lat, max_lon, max_lat) i WGS84
    limit: int  = 10,
    offset: int = 0,
) -> dict:
    params = {"limit": limit, "offset": offset}
    if bbox:
        params["bbox"] = ",".join(str(x) for x in bbox)
    return api_get(ITEMS_URL, params=params)


# Exempel: Höganäs – en av kommunerna med flest digitala detaljplaner
hoganas_bbox = (12.50, 56.18, 12.60, 56.22)

print("=== Söker detaljplaner i Höganäs ===")
result   = sok_detaljplaner(bbox=hoganas_bbox, limit=10)
features = result.get("features", [])

print(f"Matchade totalt : {result.get('numberMatched', 'okänt')}")
print(f"Returnerade     : {result.get('numberReturned', 0)}\n")

for f in features:
    props = f.get("properties", {})
    print(f"  id: {f.get('id', '-')}")
    for k, v in list(props.items())[:6]:
        print(f"    {k:<26}: {v}")
    for lnk in f.get("links", []):
        if lnk.get("rel") in ("detaljplan", "enclosure"):
            print(f"    nedladdningslänk          : {lnk['href']}")
    print()


# ============================================================
# Steg 3 – Visa alla egenskaper för första träffen (debug)
# ============================================================

if features:
    print("Alla egenskaper i första träffen:")
    print(json.dumps(features[0].get("properties", {}), indent=2, ensure_ascii=False))


# ============================================================
# Steg 4 – Hämta fullständigt domänobjekt
# ============================================================

def hamta_domanobjekt(download_url: str) -> dict:
    headers = dict(HEADERS)
    headers["Accept"] = "application/vnd.lm.detaljplan.v4+json"
    resp = requests.get(download_url, headers=headers)
    resp.raise_for_status()
    return resp.json()


if features:
    dl_url = next(
        (lnk["href"] for lnk in features[0].get("links", [])
         if lnk.get("rel") in ("detaljplan", "enclosure", "alternate")),
        None,
    )
    if dl_url:
        print(f"\nHämtar domänobjekt:\n  {dl_url}")
        domän = hamta_domanobjekt(dl_url)
        print(json.dumps(domän, indent=2, ensure_ascii=False)[:3000])
    else:
        print("\nIngen nedladdningslänk i första träffen.")
        print("Tillgängliga links:", features[0].get("links", []))


# ============================================================
# Steg 5 – Visualisera med GeoPandas
# ============================================================

def till_geodataframe(feats: list) -> gpd.GeoDataFrame:
    rows = []
    for f in feats:
        props = dict(f.get("properties", {}))
        geom  = f.get("geometry")
        if geom:
            props["geometry"] = shape(geom)
        rows.append(props)
    if not rows:
        return gpd.GeoDataFrame()
    return gpd.GeoDataFrame(rows, crs="EPSG:4326")


gdf = till_geodataframe(features)

if not gdf.empty and "geometry" in gdf.columns:
    fig, ax = plt.subplots(figsize=(10, 8))
    gdf.plot(ax=ax, color="steelblue", alpha=0.5, edgecolor="navy", linewidth=1)
    ax.set_title(f"Digitala detaljplaner – Höganäs via NGP ({len(gdf)} st)")
    ax.set_xlabel("Longitud")
    ax.set_ylabel("Latitud")
    plt.tight_layout()
    plt.show()
    cols = [c for c in gdf.columns if c != "geometry"]
    print(gdf[cols].to_string(index=False))
else:
    print("Inga geometrier att rita. Prova ett annat område eller en större bbox.")


# ============================================================
# Felkodstabell
#
#  200  → Allt fungerar! 🎉
#  401  → Token ogiltigt – kör token-cellen igen
#  403  → Prenumeration saknas i API-portalen (vanligaste felet)
#  404  → Fel URL eller collection-id
#  0 träffar → Autentisering OK men inga planer inom valt område;
#              välj en annan bbox (t.ex. Botkyrka eller Trollhättan)
# ============================================================
